{
  "version": "7.3",
  "data_api_version": "3.0",
  "routing_model": {
    "LEAD_CATEGORY": ["LEAD_PROGRAM"],
    "LEAD_PROGRAM": []
  },
  "screens": [
    {
      "id": "LEAD_CATEGORY",
      "title": "Talk to an Advisor",
      "data": {
        "categories": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": { "type": "string" },
              "title": { "type": "string" }
            }
          },
          "__example__": [
            { "id": "1", "title": "BS Programs" },
            { "id": "2", "title": "M.Phil / MS" }
          ]
        }
      },
      "layout": {
        "type": "SingleColumnLayout",
        "children": [
          {
            "type": "Form",
            "name": "category_form",
            "children": [
              {
                "type": "TextSubheading",
                "text": "Select your program level"
              },
              {
                "type": "RadioButtonsGroup",
                "name": "category",
                "label": "Program level",
                "data-source": "${data.categories}",
                "required": true
              },
              {
                "type": "Footer",
                "label": "Next",
                "on-click-action": {
                  "name": "data_exchange",
                  "payload": {
                    "category": "${form.category}"
                  }
                }
              }
            ]
          }
        ]
      }
    },
    {
      "id": "LEAD_PROGRAM",
      "title": "Talk to an Advisor",
      "terminal": true,
      "success": true,
      "data": {
        "category": { "type": "string", "__example__": "1" },
        "programs": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": { "type": "string" },
              "title": { "type": "string" }
            }
          },
          "__example__": [
            { "id": "BS Computer Science", "title": "BS Computer Science" },
            { "id": "OTHER", "title": "Other (my program isn't listed)" }
          ]
        }
      },
      "layout": {
        "type": "SingleColumnLayout",
        "children": [
          {
            "type": "Form",
            "name": "lead_form",
            "children": [
              {
                "type": "TextSubheading",
                "text": "Select your program"
              },
              {
                "type": "Dropdown",
                "name": "program",
                "label": "Program",
                "data-source": "${data.programs}",
                "required": true
              },
              {
                "type": "TextInput",
                "name": "other_program",
                "label": "If not listed above, type your program here",
                "input-type": "text",
                "required": false
              },
              {
                "type": "TextInput",
                "name": "name",
                "label": "Your full name",
                "input-type": "text",
                "required": true
              },
              {
                "type": "Footer",
                "label": "Submit",
                "on-click-action": {
                  "name": "complete",
                  "payload": {
                    "name": "${form.name}",
                    "program": "${form.program}",
                    "other_program": "${form.other_program}"
                  }
                }
              }
            ]
          }
        ]
      }
    }
  ]
}
