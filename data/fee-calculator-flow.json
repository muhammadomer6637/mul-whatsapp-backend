{
  "version": "7.3",
  "data_api_version": "3.0",
  "routing_model": {
    "CATEGORY": ["PROGRAM"],
    "PROGRAM": ["RESULT"],
    "RESULT": []
  },
  "screens": [
    {
      "id": "CATEGORY",
      "title": "Fee Calculator",
      "data": {
        "categories": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": { "type": "string" },
              "title": { "type": "string" }
            }
          },
          "__example__": [
            { "id": "bs", "title": "BS Programs" },
            { "id": "mphil", "title": "M.Phil / MS" }
          ]
        }
      },
      "layout": {
        "type": "SingleColumnLayout",
        "children": [
          {
            "type": "Form",
            "name": "category_form",
            "children": [
              {
                "type": "TextSubheading",
                "text": "Select your program level"
              },
              {
                "type": "RadioButtonsGroup",
                "name": "category",
                "label": "Program level",
                "data-source": "${data.categories}",
                "required": true
              },
              {
                "type": "Footer",
                "label": "Next",
                "on-click-action": {
                  "name": "data_exchange",
                  "payload": {
                    "category": "${form.category}"
                  }
                }
              }
            ]
          }
        ]
      }
    },
    {
      "id": "PROGRAM",
      "title": "Fee Calculator",
      "data": {
        "category": { "type": "string", "__example__": "bs" },
        "programs": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": { "type": "string" },
              "title": { "type": "string" }
            }
          },
          "__example__": [
            { "id": "BS Computer Science", "title": "BS Computer Science" },
            { "id": "BS Software Engineering", "title": "BS Software Engineering" }
          ]
        }
      },
      "layout": {
        "type": "SingleColumnLayout",
        "children": [
          {
            "type": "Form",
            "name": "program_form",
            "children": [
              {
                "type": "TextSubheading",
                "text": "Select your program"
              },
              {
                "type": "Dropdown",
                "name": "program",
                "label": "Program",
                "data-source": "${data.programs}",
                "required": true
              },
              {
                "type": "Footer",
                "label": "Check Fee",
                "on-click-action": {
                  "name": "data_exchange",
                  "payload": {
                    "category": "${data.category}",
                    "program": "${form.program}"
                  }
                }
              }
            ]
          }
        ]
      }
    },
    {
      "id": "RESULT",
      "title": "Fee Calculator",
      "terminal": true,
      "success": true,
      "data": {
        "program": { "type": "string", "__example__": "BS Computer Science" },
        "admission_fee": { "type": "string", "__example__": "PKR 25,000" },
        "installment_detail": { "type": "string", "__example__": "PKR 85,000 per installment (4 installments)" },
        "total_fee": { "type": "string", "__example__": "PKR 340,000" }
      },
      "layout": {
        "type": "SingleColumnLayout",
        "children": [
          {
            "type": "TextHeading",
            "text": "${data.program}"
          },
          {
            "type": "TextCaption",
            "text": "Admission Fee"
          },
          {
            "type": "TextBody",
            "text": "${data.admission_fee}"
          },
          {
            "type": "TextCaption",
            "text": "Quarterly Installments"
          },
          {
            "type": "TextBody",
            "text": "${data.installment_detail}"
          },
          {
            "type": "TextCaption",
            "text": "Total Fee Package"
          },
          {
            "type": "TextBody",
            "text": "${data.total_fee}"
          },
          {
            "type": "Footer",
            "label": "Done",
            "on-click-action": {
              "name": "complete",
              "payload": {
                "program": "${data.program}"
              }
            }
          }
        ]
      }
    }
  ]
}
